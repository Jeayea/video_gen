# LLM（必填：OPENROUTER_API_KEY）
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM 调用的超时与重试
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=2
LLM_JSON_RETRIES=2

# Video Provider（mock = 免费占位视频，真实 provider 后续接入）
VIDEO_PROVIDER=mock
VIDEO_CONCURRENCY=3
VIDEO_MAX_RETRIES=2
VIDEO_RETRY_BACKOFF_SEC=1.5
VIDEO_FPS=24
VIDEO_CRF=30

# ── 配音（TTS）─────────────────────────────────────────────
# edge = 微软 Edge TTS（免费、无需 key，但**需要联网**）；mock = 离线占位音
TTS_PROVIDER=edge
# 默认音色 / 按性别兜底 / 旁白音色
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
TTS_VOICE_MALE=zh-CN-YunxiNeural
TTS_VOICE_NARRATOR=zh-CN-YunjianNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
TTS_CONCURRENCY=3
TTS_MAX_RETRIES=2
TTS_RETRY_BACKOFF_SEC=1.5
TTS_TIMEOUT_SEC=60
# 每句台词后留的呼吸时间（秒），用于音画对齐
AUDIO_GAP_SEC=0.25
# 配音比镜头长时的最大容忍倍率（超过只告警，不裁音频）
AUDIO_ALIGN_MAX_RATIO=2.0

# ── BGM ───────────────────────────────────────────────────
BGM_ENABLED=true
BGM_DIR=./assets/bgm
BGM_GAIN_DB=-20
BGM_FADE_SEC=1.5
# 手动指定曲目 id（留空 = 按镜头情绪自动匹配）
BGM_ID=

# ── 成本与预算 ────────────────────────────────────────────
# 0 = 不限制；超预算时生成类操作会被拒绝（错误信息会说明还差多少）
BUDGET_USD=0
# 已用比例超过该值就在日志里告警
BUDGET_WARN_RATIO=0.8
# 单价（第三方价格会变，请按自己的账单核对；OpenRouter 的 gemini-2.5-flash 约 0.30/2.50）
LLM_INPUT_PRICE_PER_MTOK=0.30
LLM_OUTPUT_PRICE_PER_MTOK=2.50
# 真实视频 API 按秒计费（mock=0，可灵约 0.05）
VIDEO_PRICE_PER_SECOND=0
# 真实 TTS 按字符计费（edge-tts 免费=0）
TTS_PRICE_PER_MCHAR=0
# 前端「模型」下拉的候选（逗号分隔，第一项为默认）
LLM_MODEL_CANDIDATES=google/gemini-2.5-flash,google/gemini-2.5-pro,anthropic/claude-3.5-haiku

# ── 角色一致性 ────────────────────────────────────────────
# 固定 seed（0 = 不指定），真实 provider 用来稳定人物外观；角色可单独覆盖
VIDEO_SEED=0
REFERENCE_IMAGE_MAX_MB=8

# ── 批量生产 ──────────────────────────────────────────────
# 一次最多提交多少个主题
BATCH_MAX_ITEMS=20

# ── 合成 ──────────────────────────────────────────────────
# soft = mp4 内嵌 mov_text 字幕轨（推荐，只需 mov_text 编码器）
# burn = 烧进画面（需要 ffmpeg 带 libass，Homebrew 精简构建没有）
# none = 只导出 .srt 侧挂文件
COMPOSE_SUBTITLE_MODE=soft
COMPOSE_CRF=23
COMPOSE_PRESET=veryfast
COMPOSE_CONCURRENCY=2
# 字幕字号/下边距 = min(宽,高) × 该比例
COMPOSE_SUBTITLE_FONT_SCALE=0.05
COMPOSE_SUBTITLE_MARGIN_SCALE=0.04
# 保留 output/segments 中间文件（排查用）
COMPOSE_KEEP_SEGMENTS=false

# Paths
PROJECTS_DIR=./projects
# STATIC_DIR=./static
# ffmpeg：留空则依次找 PATH → imageio-ffmpeg 自带二进制
FFMPEG_PATH=ffmpeg
# ffprobe：留空则找 FFMPEG_PATH 同目录 → PATH（imageio-ffmpeg 不带 ffprobe，是可选依赖）
FFPROBE_PATH=

# 安全：留空 = 不校验（配合默认的 127.0.0.1 监听）。
# 若要从别的机器访问，请设置一个长随机串，前端用 ?token=xxx 或 X-API-Token 头访问。
API_TOKEN=
