# LLM（必填：OPENROUTER_API_KEY）
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM 调用的超时与重试
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=2
LLM_JSON_RETRIES=2

# Video Provider（Phase 2，尚未接线）
VIDEO_PROVIDER=mock

# TTS（Phase 2，尚未接线）
TTS_PROVIDER=edge

# Paths
PROJECTS_DIR=./projects
# STATIC_DIR=./static
FFMPEG_PATH=ffmpeg

# 安全：留空 = 不校验（配合默认的 127.0.0.1 监听）。
# 若要从别的机器访问，请设置一个长随机串，前端用 ?token=xxx 或 X-API-Token 头访问。
API_TOKEN=
