# LLM（必填：OPENROUTER_API_KEY）
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM 调用的超时与重试
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=2
LLM_JSON_RETRIES=2

# Video Provider
#   mock       = 免费占位片段（纯色 + 白条，用来把链路跑通）
#   openrouter = 真实视频模型，**按秒计费**（见下面 OPENROUTER_VIDEO_MODEL）
VIDEO_PROVIDER=mock

# 真实视频模型（走 OpenRouter 的统一视频接口 /api/v1/videos）
#   minimax/hailuo-3      = MiniMax H3，2K，5-15 秒档位，$0.13/秒（+$0.04/张参考图）
#   minimax/hailuo-3-max  = H3 Max，480p $0.05/秒、768p $0.08/秒，5-15 秒档位
OPENROUTER_VIDEO_MODEL=minimax/hailuo-3
# 分辨率（留空 = 交给模型默认；配错会自动换成模型支持的并告警）
VIDEO_RESOLUTION=
# 是否让视频模型生成自带音轨（我们用 TTS 配音，默认关，别多花钱）
VIDEO_GENERATE_AUDIO=false
# 角色一致性：把角色参考图（refs/）传给视频模型
VIDEO_USE_REFERENCE_IMAGES=true
# 轮询间隔与单片段超时（秒）
VIDEO_POLL_INTERVAL_SEC=10
VIDEO_TIMEOUT_SEC=900
# 合并短镜头时的目标最短时长（秒）。0 = 自动用模型最短计费档位（H3 是 5 秒）
VIDEO_MIN_SHOT_SEC=0
# 分镜阶段单个镜头的目标时长（秒）。0 = 自动取最短档位 × 1.6（H3 → 约 8 秒）
# 作用：让 LLM 一开始就产出「少而长」的镜头，避免 3 秒镜头也买 5 秒
VIDEO_SHOT_TARGET_SEC=0
# 单个镜头的时长上限（秒）。0 = 用模型最长档位（H3 = 15 秒）
VIDEO_MAX_SHOT_SEC=0
VIDEO_CONCURRENCY=3
VIDEO_MAX_RETRIES=2
VIDEO_RETRY_BACKOFF_SEC=1.5
VIDEO_FPS=24
VIDEO_CRF=30

# ── 配音（TTS）─────────────────────────────────────────────
# edge = 微软 Edge TTS（免费、无需 key，但**需要联网**）；mock = 离线占位音
TTS_PROVIDER=edge
# 默认音色 / 按性别兜底 / 旁白音色
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
TTS_VOICE_MALE=zh-CN-YunxiNeural
TTS_VOICE_NARRATOR=zh-CN-YunjianNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
TTS_CONCURRENCY=3
TTS_MAX_RETRIES=2
TTS_RETRY_BACKOFF_SEC=1.5
TTS_TIMEOUT_SEC=60
# 每句台词后留的呼吸时间（秒），用于音画对齐
AUDIO_GAP_SEC=0.25
# 配音比镜头长时的最大容忍倍率（超过只告警，不裁音频）
AUDIO_ALIGN_MAX_RATIO=2.0

# ── 配音文案（可选：让 LLM 看着真实画面写/改台词）──────────
#   off       = 只用分镜里的原文案（默认，不额外花钱）
#   narration = 只给「没有台词也没有旁白」的镜头补旁白
#   polish    = 只把已有台词/旁白改得更口语、更贴画面
#   full      = 补旁白 + 改写 + 逐句念法建议（rate/volume/pitch）
# 结果写回分镜，同一模式重跑会跳过已经写过的镜头（不重复花钱）
AUDIO_LLM_SCRIPT=off
# 是否把视频抽帧发给模型（true = 真的「看着画面」写；false = 只靠文字描述，更便宜）
AUDIO_LLM_VISION=true
# 每个镜头抽几帧（1-3）与抽帧宽度（像素）：越大越准也越贵
AUDIO_LLM_FRAMES_PER_SHOT=1
AUDIO_LLM_FRAME_WIDTH=640
# 配音文案单独指定模型（留空 = 用当前 LLM 模型）
AUDIO_LLM_MODEL=
# 单句文案的硬上限字符数（超长会按标点截断）
AUDIO_LLM_MAX_CHARS=60
# 强制重跑已生成过的文案（默认 false = 跳过，避免重复花额度）
AUDIO_LLM_FORCE=false

# ── BGM ───────────────────────────────────────────────────
BGM_ENABLED=true
BGM_DIR=./assets/bgm
BGM_GAIN_DB=-20
BGM_FADE_SEC=1.5
# 手动指定曲目 id（留空 = 按镜头情绪自动匹配）
BGM_ID=

# ── 成本与预算 ────────────────────────────────────────────
# 0 = 不限制；超预算时生成类操作会被拒绝（错误信息会说明还差多少）
BUDGET_USD=0
# 已用比例超过该值就在日志里告警
BUDGET_WARN_RATIO=0.8
# 单价（第三方价格会变，请按自己的账单核对；OpenRouter 的 gemini-2.5-flash 约 0.30/2.50）
LLM_INPUT_PRICE_PER_MTOK=0.30
LLM_OUTPUT_PRICE_PER_MTOK=2.50
# 真实视频 API 按秒计费。走 openrouter 时会**自动**从模型价目表读，
# 这里只是读不到时的兜底；mock = 0
VIDEO_PRICE_PER_SECOND=0
# ⚠️ 接真实模型前强烈建议先设预算：45 秒竖屏短片在 H3 上约 $9.75（15 镜 × 最短 5 秒 × $0.13）
# BUDGET_USD=12
# 真实 TTS 按字符计费（edge-tts 免费=0）
TTS_PRICE_PER_MCHAR=0
# 前端「模型」下拉的候选（逗号分隔，第一项为默认）
LLM_MODEL_CANDIDATES=google/gemini-2.5-flash,google/gemini-2.5-pro,anthropic/claude-3.5-haiku

# ── 角色一致性 ────────────────────────────────────────────
# 固定 seed（0 = 不指定），真实 provider 用来稳定人物外观；角色可单独覆盖
VIDEO_SEED=0
REFERENCE_IMAGE_MAX_MB=8

# ── 批量生产 ──────────────────────────────────────────────
# 一次最多提交多少个主题
BATCH_MAX_ITEMS=20

# ── 合成 ──────────────────────────────────────────────────
# soft = mp4 内嵌 mov_text 字幕轨（推荐，只需 mov_text 编码器）
# burn = 烧进画面（需要 ffmpeg 带 libass，Homebrew 精简构建没有）
# none = 只导出 .srt 侧挂文件
COMPOSE_SUBTITLE_MODE=soft
COMPOSE_CRF=23
COMPOSE_PRESET=veryfast
COMPOSE_CONCURRENCY=2
# 视频模型自带音轨怎么处理：
#   off   = 丢弃（默认，对白人声最干净）
#   under = 压低垫在人声下面（H3 等模型会生成环境音，能显著提升真实感）
COMPOSE_AMBIENT_MODE=off
COMPOSE_AMBIENT_GAIN_DB=-20
# 字幕字号/下边距 = min(宽,高) × 该比例
COMPOSE_SUBTITLE_FONT_SCALE=0.05
COMPOSE_SUBTITLE_MARGIN_SCALE=0.04
# 保留 output/segments 中间文件（排查用）
COMPOSE_KEEP_SEGMENTS=false

# Paths
PROJECTS_DIR=./projects
# STATIC_DIR=./static
# ffmpeg：留空则依次找 PATH → imageio-ffmpeg 自带二进制
FFMPEG_PATH=ffmpeg
# ffprobe：留空则找 FFMPEG_PATH 同目录 → PATH（imageio-ffmpeg 不带 ffprobe，是可选依赖）
FFPROBE_PATH=

# 安全：留空 = 不校验（配合默认的 127.0.0.1 监听）。
# 若要从别的机器访问，请设置一个长随机串，前端用 ?token=xxx 或 X-API-Token 头访问。
API_TOKEN=
