# LLM（必填：OPENROUTER_API_KEY）
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM 调用的超时与重试
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=2
LLM_JSON_RETRIES=2

# Video Provider
#   mock       = 免费占位片段（纯色 + 白条，用来把链路跑通）
#   openrouter = 真实视频模型，**按秒计费**（见下面 OPENROUTER_VIDEO_MODEL）
VIDEO_PROVIDER=mock

# 真实视频模型（走 OpenRouter 的统一视频接口 /api/v1/videos）
#   minimax/hailuo-3      = MiniMax H3，2K，5-15 秒档位，$0.13/秒（+$0.04/张参考图）
#   minimax/hailuo-3-max  = H3 Max，480p $0.05/秒、768p $0.08/秒，5-15 秒档位
OPENROUTER_VIDEO_MODEL=minimax/hailuo-3
# 分辨率（留空 = 交给模型默认；配错会自动换成模型支持的并告警）
VIDEO_RESOLUTION=
# 是否让视频模型生成自带音轨（我们用 TTS 配音，默认关，别多花钱）
VIDEO_GENERATE_AUDIO=false
# 角色一致性：把角色参考图（refs/）传给视频模型
VIDEO_USE_REFERENCE_IMAGES=true
# 轮询间隔与单片段超时（秒）
VIDEO_POLL_INTERVAL_SEC=10
VIDEO_TIMEOUT_SEC=900
# 合并短镜头时的目标最短时长（秒）。0 = 自动用模型最短计费档位（H3 是 5 秒）
VIDEO_MIN_SHOT_SEC=0
# 分镜阶段单个镜头的目标时长（秒）。0 = 自动取最短档位 × 1.6（H3 → 约 8 秒）
# 作用：让 LLM 一开始就产出「少而长」的镜头，避免 3 秒镜头也买 5 秒
VIDEO_SHOT_TARGET_SEC=0
# 单个镜头的时长上限（秒）。0 = 用模型最长档位（H3 = 15 秒）
VIDEO_MAX_SHOT_SEC=0
VIDEO_CONCURRENCY=3
VIDEO_MAX_RETRIES=2
VIDEO_RETRY_BACKOFF_SEC=1.5
VIDEO_FPS=24
VIDEO_CRF=30

# ── 配音（TTS）─────────────────────────────────────────────
# edge = 微软 Edge TTS（免费、无需 key，但**需要联网**，音色池只有 8 个中文音色）
# openrouter = 云端 TTS（openai/gpt-audio-mini，按 token 计费；可以用自然语言描述念法，
#              情绪表达力明显更强，中文发音带一点非母语味道）
# mock = 离线占位音
TTS_PROVIDER=edge
# 云端 TTS 的模型与输出格式（只在 TTS_PROVIDER=openrouter 时生效）
OPENROUTER_TTS_MODEL=openai/gpt-audio-mini
TTS_AUDIO_FORMAT=wav
# 没有逐条念法时的兜底念法（只对云端 TTS 生效：去播音腔）
TTS_DEFAULT_INSTRUCTION=自然的中文口语，像真人对话，句间有呼吸和停顿，不要播音腔
# 云端 TTS 的时长守卫：超过「按原文估算时长 × 该倍数」就判定模型自己加戏（直接失败）。
# 真实样本：一句「薇儿，为什么？」被某个音色念成 15.15 秒独白，还把括号提示念了出来
TTS_MAX_DURATION_RATIO=2.0
# ── 响度（EBU R128）───────────────────────────────────────
# 逐条配音响度归一：逐条配音是独立生成的，音色不同、响度天然不一致
# 真实项目实测：15 条云配音的集成响度 -17.8 ~ -25.7 LUFS（极差 7.9dB），
# 观众听感就是「这句话突然变小了」。开启后在合成时按条补一个**有上限的**定值增益
AUDIO_NORMALIZE=true
# 配音目标集成响度（LUFS）与单条最多修正多少 dB
# 上限的存在很关键：超过这个范围的差异通常是有意的表演（耳语/嘶吼），不该被拉平
AUDIO_TARGET_LUFS=-20
AUDIO_NORMALIZE_MAX_DB=10

# 成片整体响度归一：把「这条片子整体多响」也定死（真实成片不加是 -21.9 LUFS，
# 短剧平台普遍按 -14~-16 LUFS 播放；不加的话不同项目之间也会忽大忽小）
COMPOSE_LOUDNESS_NORMALIZE=true
COMPOSE_TARGET_LUFS=-16
COMPOSE_TRUE_PEAK_DB=-1.5

# 默认音色 / 按性别兜底 / 旁白音色
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
TTS_VOICE_MALE=zh-CN-YunxiNeural
TTS_VOICE_NARRATOR=zh-CN-YunjianNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
TTS_CONCURRENCY=3
TTS_MAX_RETRIES=2
TTS_RETRY_BACKOFF_SEC=1.5
TTS_TIMEOUT_SEC=60
# 每句台词后留的呼吸时间（秒），用于音画对齐
AUDIO_GAP_SEC=0.25
# 配音比镜头长时的最大容忍倍率（超过只告警，不裁音频）
AUDIO_ALIGN_MAX_RATIO=2.0

# ── 配音文案（可选：让 LLM 看着真实画面写/改台词）──────────
#   off       = 只用分镜里的原文案（默认，不额外花钱）
#   narration = 只给「没有台词也没有旁白」的镜头补旁白
#   polish    = 只把已有台词/旁白改得更口语、更贴画面
#   full      = 补旁白 + 改写 + 逐句念法建议（rate/volume/pitch + 云端 instruction）
#   perform   = **一个字都不改文案**，只根据画面给每个镜头写念法（云端 TTS 的最佳搭档）
# 结果写回分镜，同一模式重跑会跳过已经写过的镜头（不重复花钱）
AUDIO_LLM_SCRIPT=off
# 配音参照视频原声：off | native
#   native = 视频模型先把台词念一遍（需要 VIDEO_GENERATE_AUDIO=true），从原声里找出每句话的起止，
#            云端 TTS 听着原声、用角色自己的音色重念（节奏/停顿/情绪照原声），时长变速对齐到原声
#            后放回原声开口的位置。嘴本来就在念这句，所以这些镜头不再做逐帧口型
AUDIO_DUB_GUIDE=off
# 重念的配音与原声时长不一致时，最多变速多少倍（不变调）；差得更多就保留略长/略短
AUDIO_DUB_FIT_MAX_RATIO=1.25
# 是否把视频抽帧发给模型（true = 真的「看着画面」写；false = 只靠文字描述，更便宜）
AUDIO_LLM_VISION=true
# 每个镜头抽几帧（1-3）与抽帧宽度（像素）：越大越准也越贵
AUDIO_LLM_FRAMES_PER_SHOT=1
AUDIO_LLM_FRAME_WIDTH=640
# 配音文案单独指定模型（留空 = 用当前 LLM 模型）
AUDIO_LLM_MODEL=
# 单句文案的硬上限字符数（超长会按标点截断）
AUDIO_LLM_MAX_CHARS=60
# 强制重跑已生成过的文案（默认 false = 跳过，避免重复花额度）
AUDIO_LLM_FORCE=false

# ── BGM（背景音乐）────────────────────────────────────────
BGM_ENABLED=true
# 配乐引擎：
#   library  = 本地曲库按情绪挑一首（现成的曲子，人工准备；默认）
#   generate = **本机按分镜现写一首**：段落边界对齐镜头切换、画面动作最猛处给重音、
#              有人说话的段落去鼓并让旋律避开说话窗口，$0 不联网（推荐）
#   cli      = 外部音乐模型（MusicGen / Stable Audio 等，走 BGM_CLI_CMD）
#   auto     = 曲库有歌就用曲库，没有就现场写
#   none     = 不配乐
BGM_ENGINE=library
BGM_DIR=./assets/bgm
# 音乐相对人声的音量（生成曲本身已归一到 -18 LUFS，这里再压一档）
BGM_GAIN_DB=-20
BGM_FADE_SEC=1.5
# 手动指定曲目 id（只对 library 引擎有意义；留空 = 按镜头情绪自动匹配）
BGM_ID=
# 人声闪避：有人说话时自动把音乐压下去（sidechaincompress），说完再抬回来。
# 比固定音量好得多 —— 固定音量要么平时太小、要么说话时糊
BGM_DUCK=true
BGM_DUCK_RATIO=6
BGM_DUCK_THRESHOLD_DB=-40
BGM_DUCK_ATTACK_MS=25
BGM_DUCK_RELEASE_MS=420

# 配乐生成（BGM_ENGINE=generate/cli 时生效）
# 强制情绪色调：tense / sad / warm / hopeful / action / mystery / playful / neutral（留空 = 按分镜情绪）
MUSIC_MOOD=
# 强制速度（0 = 按色调）
MUSIC_BPM=0
# 用户的配乐要求（自由文本，会参与情绪判断），例：压抑一点，结尾要有希望，别太吵
MUSIC_NOTE=
# 混响湿量 0..1（留空/负数 = 按情绪自动：悲伤/神秘更大，动作片更干）
MUSIC_REVERB=-1
# 让 LLM 给一次配乐建议（段落/色调/能量）。**付费**（约 $0.001），默认关
MUSIC_LLM_BRIEF=false
# 外部音乐模型命令模板（BGM_ENGINE=cli）：必须含 {out} 与 {prompt}，可选 {duration} / {seconds}
# 例（把你自己的音乐模型脚本包一层，装在你自己的环境里，别污染主环境）：
#   BGM_CLI_CMD=.venv-music/bin/python my_musicgen.py --prompt "{prompt}" --seconds {seconds} --out {out}
# 提示词可以先用面板里的「看外部模型提示词」拷出来试（含调式/速度/段落时间轴）
BGM_CLI_CMD=
BGM_CLI_TIMEOUT_SEC=1200
BGM_CLI_ARGS=

# ── 成本与预算 ────────────────────────────────────────────
# 0 = 不限制；超预算时生成类操作会被拒绝（错误信息会说明还差多少）
BUDGET_USD=0
# 已用比例超过该值就在日志里告警
BUDGET_WARN_RATIO=0.8
# 单价（第三方价格会变，请按自己的账单核对；OpenRouter 的 gemini-2.5-flash 约 0.30/2.50）
LLM_INPUT_PRICE_PER_MTOK=0.30
LLM_OUTPUT_PRICE_PER_MTOK=2.50
# 真实视频 API 按秒计费。走 openrouter 时会**自动**从模型价目表读，
# 这里只是读不到时的兜底；mock = 0
VIDEO_PRICE_PER_SECOND=0
# ⚠️ 接真实模型前强烈建议先设预算：45 秒竖屏短片在 H3 上约 $9.75（15 镜 × 最短 5 秒 × $0.13）
# BUDGET_USD=12
# 真实 TTS 按字符计费（edge-tts 免费=0）
TTS_PRICE_PER_MCHAR=0
# 前端「模型」下拉的候选（逗号分隔，第一项为默认）
LLM_MODEL_CANDIDATES=google/gemini-2.5-flash,google/gemini-2.5-pro,anthropic/claude-3.5-haiku

# ── 段落分镜 ─────────────────────────────────────────────
# 同一场相邻镜头编成一段（8-15 秒、段内硬切）一次生成，再按镜头切回单镜片段（配音/口型/合成不变）。
# 一段只买一次最短档位：H3 下 3 个 3 秒镜头 = 一次 9 秒（原来要买 3×5=15 秒）
VIDEO_SEGMENT_MODE=true
VIDEO_SEGMENT_TARGET_SEC=12
VIDEO_SEGMENT_MAX_SEC=15
VIDEO_SEGMENT_MAX_SHOTS=4
# 切回单镜时把切点吸附到画面里真实的硬切（±1 秒内）
VIDEO_SEGMENT_SNAP_CUTS=true

# ── 角色一致性 ────────────────────────────────────────────
# 固定 seed（0 = 不指定），真实 provider 用来稳定人物外观；角色可单独覆盖
VIDEO_SEED=0
REFERENCE_IMAGE_MAX_MB=8
# 剧集资产：场景/道具配了参考图时一起送进视频模型（角色图永远排最前；没配图就没有影响）
VIDEO_ASSET_REFERENCES=true
# 单个镜头最多带几张参考图（角色 + 场景 + 道具合计）
VIDEO_MAX_REFERENCE_IMAGES=4
# 只认首帧的模型（Kling / Wan 不收参考图）：auto = 每段先用图片模型画一张开场关键帧
# （定妆照 + 场景图 + 第一个镜头），当首帧送进视频模型，$0.04/张；off = 不画（纯文生视频）
VIDEO_KEYFRAME=auto

# ── 批量生产 ──────────────────────────────────────────────
# 一次最多提交多少个主题
BATCH_MAX_ITEMS=20

# ── 合成 ──────────────────────────────────────────────────
# soft = mp4 内嵌 mov_text 字幕轨（浏览器/微信不渲染，只有部分桌面播放器认）
# burn = 烧进画面（需要 ffmpeg 带 libass；主 ffmpeg 没有时会自动换用带 libass 的候选）
# none = 只导出 .srt / .vtt 侧挂文件
# 三种模式都会额外导出 output/subtitles.vtt，Web 面板靠它预览字幕
COMPOSE_SUBTITLE_MODE=soft
COMPOSE_CRF=23
COMPOSE_PRESET=veryfast
COMPOSE_CONCURRENCY=2
# 成片变速（1.0 = 原速，2.0 = 2 倍速快放，0.5 = 慢放；范围 0.5~4）
# 视频模型按最短档位计费（H3 = 5 秒），所以「5 秒镜头 + 2 倍速」= 每镜观感 2.5 秒，
# 档位一分不浪费。变速在最后一道工序执行，配音/逐帧口型/BGM/烧进画面的字幕一起被
# 缩放，所以它们之间仍然同步；音频走 atempo（变速不变调，不会变成花栗鼠）。
# 注意：内嵌软字幕（soft）的时间戳不参与变速，所以变速时会自动改烧字幕；
#       侧挂 .srt/.vtt 会按倍速重算时间轴。
COMPOSE_SPEED=1
# 视频模型自带音轨怎么处理：
#   off   = 丢弃（默认，对白人声最干净）
#   under = 压低垫在人声下面（H3 等模型会生成环境音，能显著提升真实感）
COMPOSE_AMBIENT_MODE=off
COMPOSE_AMBIENT_GAIN_DB=-20
# 字幕字号/下边距 = min(宽,高) × 该比例
COMPOSE_SUBTITLE_FONT_SCALE=0.05
COMPOSE_SUBTITLE_MARGIN_SCALE=0.04
# 保留 output/segments 中间文件（排查用）
COMPOSE_KEEP_SEGMENTS=false

# Paths
PROJECTS_DIR=./projects
# STATIC_DIR=./static
# ffmpeg：留空则依次找 PATH → imageio-ffmpeg 自带二进制
FFMPEG_PATH=ffmpeg
# 主 ffmpeg 缺少所需能力（典型：brew 的 ffmpeg 没有 libass，烧不了字幕）时，
# 是否自动换用候选中带该能力的那个（imageio-ffmpeg 便携版带 libass）
FFMPEG_AUTO_UPGRADE=true
# ffprobe：留空则找 FFMPEG_PATH 同目录 → PATH（imageio-ffmpeg 不带 ffprobe，是可选依赖）
FFPROBE_PATH=

# 安全：留空 = 不校验（配合默认的 127.0.0.1 监听）。
# 若要从别的机器访问，请设置一个长随机串，前端用 ?token=xxx 或 X-API-Token 头访问。
API_TOKEN=

# 是否允许给角色选方言音色（东北话/陕西话）。默认不允许：同一部戏混口音很出戏，
# 宁可「复用通用音色 + 音高/语速区分」也不给主角上方言
TTS_ALLOW_ACCENT_VOICES=false
# 剧本严格模式：结构硬伤（空场/相邻场完全重复/LLM 评审报 error）会阻止「确认剧本」，
# 需要 force=true 才能强制确认；关掉则只提示不拦截
SCRIPT_STRICT=true
# 生成剧本后让 LLM 当一次剧本医生（钩子/转折/高潮/因果/动机），多花一次 LLM 调用
SCRIPT_LLM_REVIEW=true
# 长篇剧集大纲：默认章数 / 单批扩写章数（一次写完 20 章必被输出长度截断，所以要分批）
STORY_CHAPTERS=20
STORY_CHAPTER_CHUNK=4
# 小说模式（input_mode=novel）：无章标题时每段字数 / 超长章拆分阈值
NOVEL_CHUNK_CHARS=5000
NOVEL_CHAPTER_MAX_CHARS=12000
# 逐章抽取并发 / 生成圣经时先抽前几章（其余章在选中展开时增量抽取，角色 id 不变）
NOVEL_EXTRACT_CONCURRENCY=4
NOVEL_INITIAL_CHAPTERS=3
# 圣经最多收几个角色（小说人物多，短剧只拍主要的）/ 每章最多几个关键道具
NOVEL_MAX_CHARACTERS=12
NOVEL_MAX_PROPS_PER_CHAPTER=3

# ── 角色图（AI 生成角色参考图 = 角色一致性的唯一锚点）────────
# mock = 纯 Python 画一张纯色 PNG（不花钱，测试/跑通用）
# openrouter = 真实图片模型，POST /api/v1/images，按张计费
IMAGE_PROVIDER=openrouter
# seedream-4.5 = $0.04/张（扁平价，好算预算）；也可换 google/gemini-2.5-flash-image（按 token 计）
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
# 定妆照宽高比 / 分辨率档位（留空 = 模型默认）
IMAGE_ASPECT_RATIO=1:1
IMAGE_RESOLUTION=
IMAGE_TIMEOUT_SEC=180
# 模型没报 usage.cost 时用于记账/预估的单价（USD / 张）
IMAGE_PRICE_USD=0.04
# 生成时是否带上已有参考图（图生图，用来出「同一角色的另一个角度」）
IMAGE_USE_EXISTING_REFERENCE=false

# ── 表演与镜头（表情自然 / 动作流畅）──────────────────────
# 追加到每个视频 prompt 的「表演与连贯性」最低要求。真实样本里模型会把哭戏演成
# 舞台剧（眉毛挤成一团、身体僵硬），长 prompt 下还会变形
VIDEO_PERFORMANCE_DIRECTIVE=natural subtle expressions and micro-expressions, relaxed body language, natural blinking and breathing, smooth continuous motion, stable framing, single continuous take with no cuts, no morphing or warping, avoid exaggerated theatrical acting
# 追加到每个视频 prompt 的风格约束（英文；留空 = 不追加）
VIDEO_STYLE_PROMPT=
# 追加到每个视频 prompt 的「背景丰富度」最低要求。分镜只写一句 "in an office" 时，
# 模型会把背景画成一面空墙 —— 这段 + 场景锚点（Shot.location）是背景丰富度的来源
VIDEO_BACKGROUND_DIRECTIVE=richly detailed lived-in environment, layered foreground midground background, practical props and set dressing, visible textures and materials, motivated directional lighting, atmospheric depth of field, no empty blank walls, no plain studio void
# 是否把台词写进视频 prompt（口型对齐的关键）：写了模型才会按同一句话演口型，
# 不写它就会自己编一段话在说，我们再叠 TTS 上去口型必然对不上
VIDEO_PROMPT_DIALOGUE=true
# 口型对齐：合成时把配音延后到「画面里的人开口」的时刻（真实测量：台词进 prompt 后
# 模型仍比配音晚 0.08~1.20 秒开口）。只用本地计算，不重烧视频、不换音色
COMPOSE_ALIGN_DUB_TO_MOUTH=true
# 最大延后量（秒）：超过就不对齐；且始终保证「起点 + 配音时长 <= 片段时长」（不切尾音）
COMPOSE_MOUTH_ALIGN_MAX_SEC=1.5
# 追加到定妆照 prompt 末尾的额外约束（**必须英文**：中文会被模型画进画面）。
# 角色设定里没写人种时，用它统一整组角色的面貌基调，例如：
# IMAGE_PROMPT_SUFFIX=East Asian cast, Chinese television drama
IMAGE_PROMPT_SUFFIX=

# ── 逐帧口型（可选后处理：按配音逐帧重画嘴部）──────────────
# none = 不做（默认）；wav2lip-onnx = 内置 Wav2Lip ONNX（本地、免费、不需要 torch，
# 装在独立环境 .venv-lipsync，见 tools/lipsync/install.sh）；cli = 任意外部命令
# （LatentSync / MuseTalk 这类要 CUDA + torch 的引擎走这条路，填 LIPSYNC_CMD 即可）
LIPSYNC_ENGINE=none
# dialogue = 只处理「说话人就在画面里」的镜头（推荐，旁白镜头不该让人物动嘴）；
# all = 所有有配音的镜头
LIPSYNC_SCOPE=dialogue
# 内置引擎的解释器与模型目录（install.sh 会打印实际路径）
LIPSYNC_PYTHON=.venv-lipsync/bin/python
LIPSYNC_MODEL_DIR=assets/lipsync
LIPSYNC_MODEL=wav2lip_gan.onnx
LIPSYNC_DETECTOR=face_detection_yunet_2023mar.onnx
# cli 引擎的命令模板，必须含 {video} {audio} {out}（{report} 可选）
LIPSYNC_CMD=
# 追加给内置引擎的参数，例如特写镜头可以换回整脸裁剪：
#   LIPSYNC_EXTRA_ARGS=--crop-mode face --paste-top 0.55
LIPSYNC_EXTRA_ARGS=
# 单镜头超时（秒）与「只对小镜头做」的时长上限（0 = 不限）
LIPSYNC_TIMEOUT_SEC=900
LIPSYNC_MAX_SEC=0
# 是否顺带量「配音区间 / 嘴部改写区间」写进 output/lipsync_report.json
LIPSYNC_MEASURE=true
LIPSYNC_CONCURRENCY=1

# ── 画面运动信息进配音文案 ────────────────────────────────
# 本地实测每个镜头的运动曲线（纯标准库，免费），交给配音导演：
# 「动作最猛的时段给最重的语气，静止段放慢放轻」
AUDIO_LLM_MOTION=true
AUDIO_MOTION_FPS=6

# ── 名字 ↔ 国家 ↔ 脸（哪国人就长哪国脸）───────────────────
# 名字是唯一「总是存在」的国籍线索：中文名→中国脸、日文名（假名/日本姓氏）→日本脸、
# 韩文名→韩国脸、英文名→欧美脸。名字本身**绝不进 prompt**（会被画成画面上的文字），
# 这里把名字翻成英文的外貌锚点（average everyday <国家> face, 明确 not Westernised）
IMAGE_REGION_AUTO=true
# 名字看不出国籍时的兜底国家：cn / jp / kr / west / other
IMAGE_REGION_DEFAULT=cn
# 强制整片按某个国家来（留空 = 自动判断；例：日文名的戏要拍成国剧就填 cn）
IMAGE_REGION_OVERRIDE=
