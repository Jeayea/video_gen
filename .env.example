# 最小配置：只填 OPENROUTER_API_KEY 就能跑通全流程（视频默认是免费占位片段）。
# 其余 160 多项都有默认值，完整说明见 .env.full.example，要改哪项就把那一行抄过来。

# 必填：https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 写剧本 / 分镜用的 LLM
OPENROUTER_MODEL=google/gemini-2.5-flash

# 视频：mock = 免费占位片段；openrouter = 真实视频模型，**按秒计费**
VIDEO_PROVIDER=mock
OPENROUTER_VIDEO_MODEL=minimax/hailuo-3

# 花费上限（美元）。0 = 不限制 —— 切到真实视频模型前一定要设
BUDGET_USD=0

# 对外监听（HOST=0.0.0.0）时必须设，写接口要带 X-API-Token 请求头
API_TOKEN=
